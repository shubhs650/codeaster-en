#. ALGELINE7_22 [assisted]
#: code_aster/Messages/algeline7.py:116
#, python-format
msgid ""
"\n"
"\n"
"       ===============================================\n"
"       =                                             =\n"
"       =          Opérateur CALC_ERC_DYN             =\n"
"       =                                             =\n"
"       =        Résolution d'un problème de          =\n"
"       =      minimisation d'une fonctionnelle       =\n"
"       =    d'erreur en relation de comportement     =\n"
"       =           en dynamique linéaire.            =\n"
"       =                                             =\n"
"       =        Formulation fréquentielle.           =\n"
"       =                                             =\n"
"       ===============================================\n"
"\n"
" Nombre de fréquences demandées    = %(i1)d\n"
"\n"
" Ordres de grandeur des matrices du problème:\n"
" (informations combinant degrés de liberté physiques et de Lagrange)\n"
" (informations des termes non nuls selon un stockage de la partie\n"
"  triangulaire supérieure des matrices)\n"
" -------------------------------------------------------------------\n"
"\n"
" Dimension des matrices de masse (M) et raideur (K)  = %(i2)d x %(i2)d\n"
" Termes non nuls des matrices de masse et raideur    = %(i3)d\n"
"\n"
" Dimension de la matrice d'observation (H)           = %(i4)d x %(i2)d\n"
" Termes non nuls de la matrice d'observation         = %(i5)d\n"
" Dimension de la matrice norme (G)                   = %(i4)d x %(i4)d\n"
"\n"
" Termes non nuls du sous-bloc H^T*G*H                = %(i6)d\n"
"\n"
" Dimension de la matrice du problème d'ERC           = %(i7)d x %(i7)d\n"
" Termes non nuls de la matrice du problème d'ERC     = %(i8)d\n"
"\n"
" ===============================================\n"
"\n"
msgstr ""
"\n"
"\n"
"       ===============================================\n"
"       =                                             =\n"
"       =          Operator CALC_ERC_DYN              =\n"
"       =                                             =\n"
"       =        Solution of a minimization           =\n"
"       =      problem for an error functional        =\n"
"       =    in constitutive relation, in             =\n"
"       =           linear dynamics.                  =\n"
"       =                                             =\n"
"       =        Frequency formulation.               =\n"
"       =                                             =\n"
"       ===============================================\n"
"\n"
" Number of requested frequencies   = %(i1)d\n"
"\n"
" Orders of magnitude of the problem matrices:\n"
" (information combining physical and Lagrange degrees of freedom)\n"
" (non-zero terms counted for storage of the upper\n"
"  triangular part of the matrices)\n"
" -------------------------------------------------------------------\n"
"\n"
" Dimension of the mass (M) and stiffness (K) matrices = %(i2)d x %(i2)d\n"
" Non-zero terms of the mass and stiffness matrices   = %(i3)d\n"
"\n"
" Dimension of the observation matrix (H)             = %(i4)d x %(i2)d\n"
" Non-zero terms of the observation matrix            = %(i5)d\n"
" Dimension of the norm matrix (G)                    = %(i4)d x %(i4)d\n"
"\n"
" Non-zero terms of sub-block H^T*G*H                 = %(i6)d\n"
"\n"
" Dimension of the ERC problem matrix                 = %(i7)d x %(i7)d\n"
" Non-zero terms of the ERC problem matrix            = %(i8)d\n"
"\n"
" ===============================================\n"
"\n"

