#. PRECALCUL_61 [machine]
#: code_aster/Messages/precalcul.py:29
#, python-format
msgid ""
"\n"
"Appel à CALCUL\n"
"Le champ d'entrée numéro %(i1)d est vide.\n"
msgstr ""
"\n"
"Call to COMPUTATION\n"
" the input field number %(i1)d is empty. \n"

#. PRECALCUL_62 [machine]
#: code_aster/Messages/precalcul.py:35
#, python-format
