#. DYNAMIQUE1_3 [assisted]
#: code_aster/Messages/dynamique1.py:31
msgid ""
"Le nombre maximal d'itérations de l'algorithme d'équilibrage de bandes de fréquence est atteint.\n"
"        Il n'a pas été possible d'équilibrer les bandes de fréquence à la tolérance souhaitée."
msgstr ""
"The maximum number of iterations of the frequency band balancing algorithm was reached.\n"
"        The frequency bands could not be balanced to the required tolerance."

#. DYNAMIQUE1_4 [assisted]
#: code_aster/Messages/dynamique1.py:35
#, python-format
msgid ""
