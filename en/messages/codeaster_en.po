msgstr ""
"\n"
"The model contains elements that are not connected to each other.\n"
"\n"
"Advice:  use DISTRIBUTION / METHODE='CENTRALISE'.\n"

#. PARTITION1_1 [assisted]
#: code_aster/Messages/partition1.py:23
#, python-format
msgid ""
"\n"
" Il y a moins de sous-domaines (%(i1)d) que de processeurs participant au calcul (%(i2)d).\n"
"\n"
