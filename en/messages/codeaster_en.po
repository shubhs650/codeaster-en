#. CALCULEL2_58 [assisted]
#: code_aster/Messages/calculel2.py:334
#, python-format
msgid ""
"\n"
"Erreur Utilisateur :\n"
"  Vous utilisez le mot clé PILOTAGE et votre calcul utilise des variables de\n"
"  commande qui dépendent du temps (mot clé AFFE_VARC / EVOL).\n"
"  C'est interdit.\n"
"  Champ de matériau : %(k1)s\n"
"Conseil :\n"
"  Lorsque l'on utilise le mot clé PILOTAGE, les variables de commande ne doivent\n"
"  pas dépendre du temps.\n"
"  Il faut utiliser le mot clé AFFE_VARC / CHAM_GD\n"
msgstr ""
"\n"
"User error:\n"
"  You use keyword PILOTAGE and your computation uses\n"
"  time-dependent external state variables (keyword AFFE_VARC / EVOL).\n"
"  This is not allowed.\n"
"  Material field: %(k1)s\n"
"Advice:\n"
"  With keyword PILOTAGE, the external state variables must not\n"
"  depend on time.\n"
"  Use keyword AFFE_VARC / CHAM_GD\n"

