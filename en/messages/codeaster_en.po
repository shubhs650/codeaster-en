#. RUPTURE4_19 [assisted]
#: code_aster/Messages/rupture4.py:102
msgid ""
"\n"
"L'impression d'un résultat n'est pas compatible avec\n"
"l'utilisation de plusieurs paramètres matériaux,\n"
"ou dans le cas METHODE_2D la projection sur plusieurs plans.\n"
"        "
msgstr ""
"\n"
"Printing a result is not compatible with\n"
"using several material parameters,\n"
"or, with METHODE_2D, projecting onto several planes.\n"
"        "

#. RUPTURE4_20 [assisted]
#: code_aster/Messages/rupture4.py:109
