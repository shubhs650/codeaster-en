#. CALCULEL_88 [assisted]
#: code_aster/Messages/calculel.py:570
#, python-format
msgid ""
"\n"
" Commande CALC_FERRAILLAGE : ATTENTION un champ de ferraillage existe déjà au numéro d'ordre %(i1)d du résultat %(k1)s\n"
"   Ce champ de ferraillage sera écrasé !\n"
msgstr ""
