#. ADAPTATION_1 [machine]
#: code_aster/Messages/adaptation.py:25
msgid ""
"\n"
"  Adaptation du pas de temps.\n"
msgstr ""
"\n"
" Adaptation of the time step. \n"

#. ADAPTATION_2 [machine]
#: code_aster/Messages/adaptation.py:30
#, python-format
msgid ""
"\n"
"    Pour la méthode d'adaptation de type <%(k1)s>, le pas de temps calculé vaut <%(r1)19.12e>.\n"
msgstr ""
"\n"
" For the method of adaptation of the  type %(k1)s, the computed time step is worth  %(r1)19.12e. \n"

#. ADAPTATION_3 [machine]
#: code_aster/Messages/adaptation.py:35
#, python-format
msgid ""
"\n"
"    Pour la méthode d'adaptation de type <%(k1)s>, le critère n'est pas vérifié. Le pas de temps n'est pas adapté.\n"
msgstr ""
"\n"
" For the method of adaptation of the  type %(k1)s, the criterion is not checked. The time step is not adapted. \n"

#. ADAPTATION_4 [machine]
#: code_aster/Messages/adaptation.py:40
#, python-format
msgid ""
"\n"
"    Aucun critère d'adaptation n'est vérifié. On garde le pas de temps <%(r1)19.12e>.\n"
msgstr ""
"\n"
" No criterion of adaptation is checked. The time step  is kept %(r1)19.12e. \n"

#. ADAPTATION_5 [machine]
#: code_aster/Messages/adaptation.py:45
#, python-format
msgid ""
"\n"
"    Sur tous les critères d'adaptation, le plus petit pas de temps vaut <%(r1)19.12e>.\n"
msgstr ""
"\n"
" On all the criteria of adaptation, the smallest time step is worth  %(r1)19.12e. \n"

#. ADAPTATION_6 [machine]
#: code_aster/Messages/adaptation.py:50
#, python-format
msgid ""
"\n"
"    Après ajustement sur les points de passage obligatoires, le plus petit pas de temps vaut <%(r1)19.12e>.\n"
msgstr ""
"\n"
" After best fit on the compulsory points of transition, the smallest time step is worth  %(r1)19.12e. \n"

#. ADAPTATION_10 [machine]
#: code_aster/Messages/adaptation.py:55
#, python-format
msgid ""
"\n"
"    On maintient la découpe du pas de temps à <%(r1)19.12e>.\n"
msgstr ""
"\n"
" One maintains the cutting of the time step with  %(r1)19.12e. \n"

#. ADAPTATION_11 [machine]
#: code_aster/Messages/adaptation.py:60
#, python-format
msgid ""
"\n"
"    La valeur du pas de temps retenu <%(r1)19.12e> est inférieure à PAS_MINI.\n"
msgstr ""
"\n"
" The value of the time step selected  %(r1)19.12e is lower than PAS_MINI. \n"

#. ADAPTATION_12 [machine]
#: code_aster/Messages/adaptation.py:65
#, python-format
msgid ""
"\n"
"    La valeur du pas de temps <%(r1)19.12e> est supérieure à PAS_MAXI <%(r2)19.12e>.\n"
"    On limite le pas de temps à PAS_MAXI <%(r2)19.12e>.\n"
msgstr ""
"\n"
" The value of the time step  %(r1)19.12e is higher than PAS_MAXI  %(r2)19.12e. \n"
" One limits the time step to PAS_MAXI  %(r2)19.12e. \n"

#. ADAPTATION_13 [assisted]
#: code_aster/Messages/adaptation.py:71
msgid ""
"On a atteint le nombre maximal de pas de temps autorisé dans DEFI_LIST_INST. On arrête le calcul."
msgstr ""
"The maximum number of time steps allowed in DEFI_LIST_INST was reached. The computation stops."

#. ADAPTATION_20 [assisted]
#: code_aster/Messages/adaptation.py:74
#, python-format
msgid ""
"\n"
"    Pour la méthode d'adaptation de type DELTA_GRANDEUR - %(k1)s / %(k2)s. Le pas de temps calculé vaut <%(r1)19.12e>.\n"
msgstr ""
"\n"
"    For adaptation method DELTA_GRANDEUR - %(k1)s / %(k2)s. The computed time step is <%(r1)19.12e>.\n"

#. AFFECARAELEM_2 [assisted]
#: code_aster/Messages/affecaraelem.py:26
msgid ""
"AFFE_CARA_ELEM\n"
"Au moins un des mot-clés facteur d'AFFE_CARA_ELEM n'a aucune affection sur des GROUP_MA,\n"
"des MAILLES ou sur TOUT='OUI'.\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM\n"
"At least one factor keyword of AFFE_CARA_ELEM is not assigned to any GROUP_MA,\n"
"MAILLE or TOUT='OUI'.\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_10 [assisted]
#: code_aster/Messages/affecaraelem.py:35
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Une maille dans le groupe <%(k2)s> n'est pas de la bonne topologique.\n"
"Vous êtes en 2D, la topologie des mailles doit être 1.\n"
"Les mailles de <%(k2)s> doivent être des segments.\n"
"\n"
"Pour information :\n"
" - nom de la maille incriminée                       : %(k3)s\n"
" - dimension topologique de la maille incriminée     : %(i3)d\n"
" - type de la maille incriminée                      : %(k4)s\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"An element in group <%(k2)s> does not have the right topology.\n"
"You are in 2D, so the element topology must be 1.\n"
"The elements of <%(k2)s> must be segments.\n"
"\n"
"For information:\n"
" - name of the element concerned                   : %(k3)s\n"
" - topological dimension of the element concerned  : %(i3)d\n"
" - type of the element concerned                   : %(k4)s\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_11 [assisted]
#: code_aster/Messages/affecaraelem.py:49
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Une maille dans le groupe  <%(k2)s> n'a pas la bonne dimension topologique.\n"
"\n"
"Les mailles de <%(k2)s> doivent être des segments ou des éléments de surfaces.\n"
"Pour information :\n"
" - maille concernée         : %(k3)s\n"
" - sa dimension topologique : %(i2)d\n"
" - son type                 : %(k4)s\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"An element in group <%(k2)s> does not have the right topological dimension.\n"
"\n"
"The elements of <%(k2)s> must be segments or surface elements.\n"
"For information:\n"
" - element concerned         : %(k3)s\n"
" - its topological dimension : %(i2)d\n"
" - its type                  : %(k4)s\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_12 [assisted]
#: code_aster/Messages/affecaraelem.py:62
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"La maille %(k3)s est présente au moins 2 fois dans la définition de la surface.\n"
"\n"
"Les mailles ne doivent être présente qu'une seule fois, en cas de doublon :\n"
"- La surface totale de répartition ne peut pas être correctement déterminée.\n"
"- La contribution de cette maille n'est pas correcte.\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Element %(k3)s appears at least twice in the definition of the surface.\n"
"\n"
"Elements must appear only once; with a duplicate:\n"
"- The total distribution surface cannot be determined correctly.\n"
"- The contribution of this element is not correct.\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_13 [assisted]
#: code_aster/Messages/affecaraelem.py:73
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"La maille %(k3)s présente dans <%(k2)s> n'a pas le bon nombre de noeuds.\n"
"Les mailles gérées doivent avoir %(k5)s noeuds\n"
"\n"
"Pour information :\n"
" - maille concernée              : %(k3)s\n"
" - son type                      : %(k4)s\n"
" - nombre de noeuds de la maille : %(i2)d\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Element %(k3)s in <%(k2)s> does not have the right number of nodes.\n"
"The supported elements must have %(k5)s nodes\n"
"\n"
"For information:\n"
" - element concerned          : %(k3)s\n"
" - its type                   : %(k4)s\n"
" - number of element nodes    : %(i2)d\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_14 [assisted]
#: code_aster/Messages/affecaraelem.py:86
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Au moins un élément appartenant au GROUP_MA_POI1 <%(k2)s> n'est pas connecté aux mailles\n"
"surfaciques du GROUP_MA.\n"
"\n"
"Pour pouvoir calculer la contribution de la maille, il faut que tous les noeuds de <%(k2)s> soient\n"
"en relation avec un seul noeud d'une maille surfacique du GROUP_MA.\n"
"\n"
"Pour information :\n"
" - maille détectée : %(k3)s\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"At least one element of GROUP_MA_POI1 <%(k2)s> is not connected to the surface\n"
"elements of GROUP_MA.\n"
"\n"
"To compute the element contribution, every node of <%(k2)s> must be\n"
"linked to exactly one node of a surface element of GROUP_MA.\n"
"\n"
"For information:\n"
" - element detected: %(k3)s\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_15 [assisted]
#: code_aster/Messages/affecaraelem.py:100
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Au moins un noeud appartenant à un élément du GROUP_MA surfacique n'est pas connecté à une maille du\n"
"GROUP_MA_POI1.\n"
"\n"
"Pour pouvoir répartir la contribution des mailles surfaciques, il faut que tous les noeuds\n"
"soient en relation avec une et une seule maille de GROUP_MA_POI1.\n"
"\n"
"Pour information :\n"
" - noeud concerné : %(k2)s\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"At least one node of an element of the surface GROUP_MA is not connected to an element of\n"
"GROUP_MA_POI1.\n"
"\n"
"To distribute the contribution of the surface elements, every node must\n"
"be linked to exactly one element of GROUP_MA_POI1.\n"
"\n"
"For information:\n"
" - node concerned: %(k2)s\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_16 [assisted]
#: code_aster/Messages/affecaraelem.py:114
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Des éléments appartenant au GROUP_MA_POI1 <%(k2)s> n'ont pas le bon nombre de noeuds.\n"
"Les mailles doivent être de type POI1 et posséder 1 seul noeud.\n"
"\n"
"Pour information :\n"
" - maille détectée : %(k3)s\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Elements of GROUP_MA_POI1 <%(k2)s> do not have the right number of nodes.\n"
"The elements must be of type POI1 and have a single node.\n"
"\n"
"For information:\n"
" - element detected: %(k3)s\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_17 [assisted]
#: code_aster/Messages/affecaraelem.py:125
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Les mailles appartenant au GROUP_MA sont surfaciques. Vous ne devez pas utiliser\n"
"TYPE=LINEIQUE mais TYPE=SURFACIQUE ou TOTALE.\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"The elements of GROUP_MA are surface elements. Do not use\n"
"TYPE=LINEIQUE; use TYPE=SURFACIQUE or TOTALE.\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_18 [assisted]
#: code_aster/Messages/affecaraelem.py:133
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Les mailles appartenant au GROUP_MA sont linéiques. Vous ne devez pas utiliser\n"
"TYPE=SURFACIQUE mais TYPE=LINEIQUE ou TOTALE.\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"The elements of GROUP_MA are line elements. Do not use\n"
"TYPE=SURFACIQUE; use TYPE=LINEIQUE or TOTALE.\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_19 [assisted]
#: code_aster/Messages/affecaraelem.py:141
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Le noeud <%(k5)s> de la maille <%(k3)s> appartenant au GROUP_MA_POI1 <%(k2)s> est connecté\n"
"avec un noeud d'une maille surfacique du GROUP_MA qui est déjà connecté à la maille\n"
"<%(k4)s> du GROUP_MA_POI1.\n"
"\n"
"Les mailles de <%(k2)s> ne doivent être connecté qu'a un seul noeud des mailles de surface.\n"
"Les noeuds des mailles de surface ne doivent être connecté qu'a un seul noeud des mailles POI1.\n"
"La relation doit être bijective.\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Node <%(k5)s> of element <%(k3)s> in GROUP_MA_POI1 <%(k2)s> is connected\n"
"to a node of a surface element of GROUP_MA that is already connected to element\n"
"<%(k4)s> of GROUP_MA_POI1.\n"
"\n"
"The elements of <%(k2)s> must be connected to only one node of the surface elements.\n"
"The nodes of the surface elements must be connected to only one node of the POI1 elements.\n"
"The relation must be one-to-one.\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_20 [assisted]
#: code_aster/Messages/affecaraelem.py:154
#, python-format
msgid ""
"\n"
"AFFE_CARA_ELEM. Il y a %(i1)d occurrences du mot clef facteur <%(k1)s>.\n"
"Entre ces différentes occurrences les GROUP_MA_POI1 ont %(i2)d mailles en communs.\n"
"La règle de surcharge est donc appliquée %(i2)d fois.\n"
"La liste des mailles surchargées est affichée avec INFO=2.\n"
msgstr ""
"\n"
"AFFE_CARA_ELEM. There are %(i1)d occurrences of factor keyword <%(k1)s>.\n"
"Across these occurrences, the GROUP_MA_POI1 share %(i2)d elements.\n"
"The overriding rule is therefore applied %(i2)d times.\n"
"The list of overridden elements is printed with INFO=2.\n"

#. AFFECARAELEM_21 [assisted]
#: code_aster/Messages/affecaraelem.py:162
#, python-format
msgid ""
"\n"
"AFFE_CARA_ELEM / MASS_REP. Occurrence %(i1)d.\n"
"\n"
"Le nombre des mailles POI1 affectées lors des différentes occurrences de MASS_REP dépasse\n"
"le nombre de DIS_T/DIS_TR présent dans le modèle : %(i3)d\n"
"\n"
"Pour information :\n"
"- le nombre de maille de type POI1 précédemment affecté par MASS_REP est de %(i4)d\n"
"- le nombre de maille de type POI1 dans %(k1)s est %(i2)d\n"
"\n"
"Conseils : Vérifiez que lors de votre AFFE_MODELE, vous n'avez pas oublié d'affecter des\n"
"           DIS_T ou DIS_TR.\n"
msgstr ""
"\n"
"AFFE_CARA_ELEM / MASS_REP. Occurrence %(i1)d.\n"
"\n"
"The number of POI1 elements assigned over the occurrences of MASS_REP exceeds\n"
"the number of DIS_T/DIS_TR in the model: %(i3)d\n"
"\n"
"For information:\n"
"- the number of POI1 elements previously assigned by MASS_REP is %(i4)d\n"
"- the number of POI1 elements in %(k1)s is %(i2)d\n"
"\n"
"Advice: check that you did not forget to assign DIS_T or DIS_TR\n"
"           in AFFE_MODELE.\n"

#. AFFECARAELEM_22 [assisted]
#: code_aster/Messages/affecaraelem.py:177
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Des éléments appartenant au GROUP_MA_POI1 <%(k2)s> ne sont pas dans le modèle.\n"
"\n"
"Pour information :\n"
" - maille détectée : %(k3)s\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Elements of GROUP_MA_POI1 <%(k2)s> are not in the model.\n"
"\n"
"For information:\n"
" - element detected: %(k3)s\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_23 [assisted]
#: code_aster/Messages/affecaraelem.py:187
#, python-format
msgid ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"Une maille dans le groupe <%(k2)s> n'est pas de la bonne topologique.\n"
"Vous êtes en 3D, la topologie des mailles dans le groupe doit être identique.\n"
"\n"
"Les mailles de <%(k2)s> doivent être des segments ou des éléments de surfaces.\n"
"\n"
"Pour information :\n"
" - nom de la maille incriminée                       : %(k3)s\n"
" - dimension topologique de la maille incriminée     : %(i3)d\n"
" - type de la maille incriminée                      : %(k4)s\n"
"\n"
"La topologie du groupe est déterminée par la 1ère maille du groupe.\n"
" - nom de la 1ère maille du groupe                   : %(k5)s\n"
" - dimension topologique du groupe                   : %(i2)d\n"
" - type de la 1ère maille du groupe                  : %(k6)s\n"
"\n"
"Vérifiez vos données.\n"
msgstr ""
"AFFE_CARA_ELEM / <%(k1)s> / occurrence %(i1)d\n"
"An element in group <%(k2)s> does not have the right topology.\n"
"You are in 3D, so all elements in the group must have the same topology.\n"
"\n"
"The elements of <%(k2)s> must be segments or surface elements.\n"
"\n"
"For information:\n"
" - name of the element concerned                   : %(k3)s\n"
" - topological dimension of the element concerned  : %(i3)d\n"
" - type of the element concerned                   : %(k4)s\n"
"\n"
"The topology of the group is set by its 1st element.\n"
" - name of the 1st element of the group            : %(k5)s\n"
" - topological dimension of the group              : %(i2)d\n"
" - type of the 1st element of the group            : %(k6)s\n"
"\n"
"Check your data.\n"

#. AFFECARAELEM_24 [assisted]
#: code_aster/Messages/affecaraelem.py:207
#, python-format
msgid ""
"AFFE_CARA_ELEM / RIGI_PARASOL\n"
"Pour l'occurrence %(i1)d de RIGI_PARASOL, GROUP_MA = %(k1)s.\n"
"La maille %(k2)s est présente plusieurs fois.\n"
"Elle n'est prise en compte qu'une seule fois.\n"
msgstr ""
"AFFE_CARA_ELEM / RIGI_PARASOL\n"
"For occurrence %(i1)d of RIGI_PARASOL, GROUP_MA = %(k1)s.\n"
"Element %(k2)s appears several times.\n"
"It is taken into account only once.\n"

#. AFFECARAELEM_25 [assisted]
#: code_aster/Messages/affecaraelem.py:214
#, python-format
msgid ""
"AFFE_CARA_ELEM / RIGI_PARASOL\n"
"Pour l'occurrence %(i1)d de RIGI_PARASOL, GROUP_MA[_POI1|_SEG2] = %(k1)s.\n"
"La maille %(k2)s ne fait pas partie du modèle.\n"
"\n"
"Vérifier l'affection du modèle.\n"
msgstr ""
"AFFE_CARA_ELEM / RIGI_PARASOL\n"
"For occurrence %(i1)d of RIGI_PARASOL, GROUP_MA[_POI1|_SEG2] = %(k1)s.\n"
"Element %(k2)s is not part of the model.\n"
"\n"
"Check the model assignment.\n"

#. AFFECARAELEM_26 [assisted]
#: code_aster/Messages/affecaraelem.py:222
#, python-format
msgid ""
"AFFE_CARA_ELEM / RIGI_GRILLE\n"
"Pour l'occurrence %(i1)d de RIGI_GRILLE, GROUP_MA = %(k1)s.\n"
"La maille %(i2)d n'a pas la dimension topologique égale à 2.\n"
msgstr ""
"AFFE_CARA_ELEM / RIGI_GRILLE\n"
"For occurrence %(i1)d of RIGI_GRILLE, GROUP_MA = %(k1)s.\n"
"Element %(i2)d does not have topological dimension 2.\n"

#. AFFECARAELEM_27 [assisted]
#: code_aster/Messages/affecaraelem.py:228
#, python-format
msgid ""
"AFFE_CARA_ELEM / RIGI_GRILLE\n"
"Pour l'occurrence %(i1)d de RIGI_GRILLE, GROUP_MA_SEG2 = %(k1)s.\n"
"Ce groupe contient %(i2)d mailles, mais la dalle est composée de %(i3)d noeuds.\n"
"\n"
"Il faut avoir autant de mailles que de noeuds.\n"
msgstr ""
"AFFE_CARA_ELEM / RIGI_GRILLE\n"
