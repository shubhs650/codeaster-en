#. MODELISA9_61 [machine]
#: code_aster/Messages/modelisa9.py:258
#, python-format
msgid ""
"\n"
" Erreur lors de la définition de la courbe de traction : %(k1)s\n"
"\n"
" la courbe de traction doit satisfaire les conditions suivantes :\n"
" - les abscisses (déformations) doivent être strictement croissantes,\n"
" - la pente entre 2 points successifs doit être inférieure a la pente\n"
"   élastique (module de Young) entre 0 et le premier point de la courbe.\n"
"\n"
" pente initiale (module de Young) :   %(r1)f\n"
" pente courante                  :   %(r2)f\n"
" pour l'abscisse                 :   %(r3)f\n"
"\n"
msgstr ""
"\n"
" Error at the time of the definition of the traction diagram:  %(k1)s \n"
" \n"
" the traction diagram must satisfy the following conditions: \n"
" - the X-coordinates (strains) must be strictly increasing,\n"
" - the slope between 2 successive points must be lower has the elastic\n"
" slope (Young's modulus) between 0 and the first point of the curve. \n"
" \n"
" initial slope (Young's modulus):  %(r1)f \n"
" current slope:  %(r2)f \n"
" for the X-coordinate:  %(r3)f \n"
" \n"

