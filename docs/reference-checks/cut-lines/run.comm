# Checks for the MACR_LIGN_COUPE / POST_RCCM / DEFI_CONSTANTE references (task 2.3e).
# solid_static fixture (copy tests/fixtures/solid_static/input/mesh.med next to this file).
# Units: mm, N, MPa. Ends with a run that is expected to stop (LC, see README).
DEBUT()

P = 2.0  # internal pressure [MPa]

MAIL = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

MAIL = DEFI_GROUP(reuse=MAIL, MAILLAGE=MAIL, CREA_GROUP_NO=_F(GROUP_MA="BASE"))

MAIL = MODI_MAILLAGE(reuse=MAIL, MAILLAGE=MAIL, ORIE_PEAU=_F(GROUP_MA_PEAU=("P_SHELL", "P_NOZZLE")))

# TOUT="OUI" so the pressure faces (TRIA3 skin cells) get boundary elements, as in forma01a.
MODE = AFFE_MODELE(MAILLAGE=MAIL, AFFE=_F(TOUT="OUI", PHENOMENE="MECANIQUE", MODELISATION="3D"))

ACIER = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3))

MATE = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(GROUP_MA="SOLID", MATER=ACIER))

FIXE = AFFE_CHAR_MECA(MODELE=MODE, DDL_IMPO=_F(GROUP_MA="BASE", DX=0.0, DY=0.0, DZ=0.0))

PRESS = AFFE_CHAR_MECA(MODELE=MODE, PRES_REP=_F(GROUP_MA=("P_SHELL", "P_NOZZLE"), PRES=P))

RESU = MECA_STATIQUE(
    MODELE=MODE,
    CHAM_MATER=MATE,
    EXCIT=(_F(CHARGE=FIXE), _F(CHARGE=PRESS)),
    SOLVEUR=_F(METHODE="MUMPS"),
)

RESU = CALC_CHAMP(
    reuse=RESU,
    RESULTAT=RESU,
    CONTRAINTE=("SIGM_ELNO", "SIGM_NOEU"),
    CRITERES=("SIEQ_ELNO", "SIEQ_NOEU"),
    FORCE="REAC_NODA",
)


# wall line on -Y side, z=75: x local = -Y (radial), so local SIXX = radial stress
LA = MACR_LIGN_COUPE(
    RESULTAT=RESU,
    NOM_CHAM="SIGM_NOEU",
    LIGN_COUPE=(
        _F(INTITULE="LOC", TYPE="SEGMENT", NB_POINTS=11, COOR_ORIG=(0.0, -100.0, 75.0),
           COOR_EXTR=(0.0, -120.0, 75.0), REPERE="LOCAL", VECT_Y=(1.0, 0.0, 0.0)),
        _F(INTITULE="INI", TYPE="SEGMENT", NB_POINTS=11, COOR_ORIG=(0.0, -100.0, 75.0),
           COOR_EXTR=(0.0, -120.0, 75.0)),
    ),
)
IMPR_TABLE(TABLE=LA, FORMAT="TABLEAU", SEPARATEUR=",", UNITE=31)

LB = MACR_LIGN_COUPE(
    RESULTAT=RESU,
    NOM_CHAM="SIGM_NOEU",
    LIGN_COUPE=_F(INTITULE="LOC", TYPE="SEGMENT", NB_POINTS=11, COOR_ORIG=(0.0, -100.0, 75.0),
           COOR_EXTR=(0.0, -120.0, 75.0), REPERE="LOCAL", VECT_Y=(1.0, 0.0, 0.0)),
)
IMPR_TABLE(TABLE=LB, FORMAT="TABLEAU", SEPARATEUR=",", UNITE=32)

# linearization through the wall (opposite the nozzle), element-node stresses
TW = MACR_LIGN_COUPE(
    RESULTAT=RESU,
    NOM_CHAM="SIGM_ELNO",
    LIGN_COUPE=_F(INTITULE="WALL", TYPE="SEGMENT", NB_POINTS=21, COOR_ORIG=(0.0, -100.0, 75.0),
           COOR_EXTR=(0.0, -120.0, 75.0)),
)
IMPR_TABLE(TABLE=TW, FORMAT="TABLEAU", SEPARATEUR=",", UNITE=33)

MRCC = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3), RCCM=_F(SM=150.0))
PMPB = POST_RCCM(
    TYPE_RESU_MECA="EVOLUTION",
    OPTION="PM_PB",
    MATER=MRCC,
    TRANSITOIRE=_F(TABL_RESU_MECA=TW, TOUT_INST="OUI"),
)
IMPR_TABLE(TABLE=PMPB, FORMAT="TABLEAU", SEPARATEUR=",", UNITE=34)
PMPBD = POST_RCCM(
    TYPE_RESU_MECA="EVOLUTION",
    TYPE_RESU="DETAILS",
    OPTION="PM_PB",
    MATER=MRCC,
    TRANSITOIRE=_F(TABL_RESU_MECA=TW, TOUT_INST="OUI"),
)
IMPR_TABLE(TABLE=PMPBD, FORMAT="TABLEAU", SEPARATEUR=",", UNITE=35)

ZERO = DEFI_CONSTANTE(VALE=0.0)
FIXF = AFFE_CHAR_MECA_F(MODELE=MODE, DDL_IMPO=_F(GROUP_MA="BASE", DX=ZERO, DY=ZERO, DZ=ZERO))
RESF = MECA_STATIQUE(MODELE=MODE, CHAM_MATER=MATE, EXCIT=(_F(CHARGE=FIXF), _F(CHARGE=PRESS)))
RESF = CALC_CHAMP(reuse=RESF, RESULTAT=RESF, FORCE="REAC_NODA")
REAF = POST_RELEVE_T(ACTION=_F(OPERATION="EXTRACTION", INTITULE="REAC_F", RESULTAT=RESF,
    NOM_CHAM="REAC_NODA", GROUP_NO="BASE", RESULTANTE=("DX", "DY", "DZ")))
IMPR_TABLE(TABLE=REAF, FORMAT="TABLEAU", SEPARATEUR=",", UNITE=36)

# reversed order: INITIAL first, LOCAL last (last REPERE drives both, expected to fail)
LC = MACR_LIGN_COUPE(
    RESULTAT=RESU,
    NOM_CHAM="SIGM_NOEU",
    LIGN_COUPE=(
        _F(INTITULE="INI", TYPE="SEGMENT", NB_POINTS=11, COOR_ORIG=(0.0, -100.0, 75.0),
           COOR_EXTR=(0.0, -120.0, 75.0)),
        _F(INTITULE="LOC", TYPE="SEGMENT", NB_POINTS=11, COOR_ORIG=(0.0, -100.0, 75.0),
           COOR_EXTR=(0.0, -120.0, 75.0), REPERE="LOCAL", VECT_Y=(1.0, 0.0, 0.0)),
    ),
)
IMPR_TABLE(TABLE=LC, FORMAT="TABLEAU", SEPARATEUR=",", UNITE=37)

FIN()
