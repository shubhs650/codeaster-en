Content of the file to execute:
# coding=utf-8
# original filename
__file__ = r"/work/input/run.comm"

# broken_bad_keyword -- deliberately broken run (task 4.3): PRES_REP takes PRES, not PRESSION (keyword not in the catalog).
# codeaster-en test fixture. Copy of shell_static (same mesh, units mm, N, MPa) cut after
# MECA_STATIQUE, with one fault injected. DEBUT() without CODE, as a user's study would run.
# The .mess this produces is a parser and classifier test input; the run is expected to fail.


# temporarly added for compatibility with code_aster legacy
from math import *

import code_aster
from code_aster.Commands import *
from code_aster import CA

DEBUT()

Q = 0.01  # uniform pressure [MPa]
T = 10.0  # thickness [mm]

MAIL = LIRE_MAILLAGE(FORMAT="MED", UNITE=20)

MAIL = DEFI_GROUP(reuse=MAIL, MAILLAGE=MAIL, CREA_GROUP_NO=_F(TOUT_GROUP_MA="OUI"))

# Mesh normals already point to +Z; this makes the orientation explicit and checked.
MAIL = MODI_MAILLAGE(
    reuse=MAIL,
    MAILLAGE=MAIL,
    ORIE_NORM_COQUE=_F(GROUP_MA="PLATE", GROUP_NO="CENTER", VECT_NORM=(0.0, 0.0, 1.0)),
)

MODE = AFFE_MODELE(
    MAILLAGE=MAIL, AFFE=_F(GROUP_MA="PLATE", PHENOMENE="MECANIQUE", MODELISATION="DKT")
)

CARA = AFFE_CARA_ELEM(MODELE=MODE, COQUE=_F(GROUP_MA="PLATE", EPAIS=T, ANGL_REP=(0.0, 0.0)))

ACIER = DEFI_MATERIAU(ELAS=_F(E=210000.0, NU=0.3))

MATE = AFFE_MATERIAU(MAILLAGE=MAIL, AFFE=_F(GROUP_MA="PLATE", MATER=ACIER))

APPUI = AFFE_CHAR_MECA(
    MODELE=MODE,
    DDL_IMPO=(
        _F(GROUP_MA="EDGES", DZ=0.0),
        _F(GROUP_NO="CORNER_A", DX=0.0, DY=0.0),
        _F(GROUP_NO="CORNER_B", DY=0.0),
    ),
)

# Positive PRES acts against the element normal (+Z), i.e. downward (as in ssls101n).
# fault: bad keyword
PRESS = AFFE_CHAR_MECA(MODELE=MODE, PRES_REP=_F(GROUP_MA="PLATE", PRESSION=Q))

RESU = MECA_STATIQUE(
    MODELE=MODE,
    CHAM_MATER=MATE,
    CARA_ELEM=CARA,
    EXCIT=(_F(CHARGE=APPUI), _F(CHARGE=PRESS)),
    SOLVEUR=_F(METHODE="MUMPS"),
)


FIN()



